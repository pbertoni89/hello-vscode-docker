{
  "name": "Hello Project Container",
  "image": "pbertoni/hello-vscode-docker:latest",
  "runArgs": [
    "--hostname",
    "r4p-build-environment-lorem-ipsum"
  ],
  "customizations": {
    "vscode": {
      "settings": {
        "git.path": "/usr/bin/git"
      },
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  }
}
